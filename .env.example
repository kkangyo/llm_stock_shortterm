# Anthropic (Claude) API key - https://console.anthropic.com/ (analysis.backend: "claude")
ANTHROPIC_API_KEY=

# Google Gemini API key - https://aistudio.google.com/apikey (analysis.backend: "gemini")
# 무료 티어 제공 (2.5 Flash 기준 분당 10회/일 500회, 2026년 기준). 무료 티어 데이터는
# 구글이 자사 제품 개선에 활용할 수 있음 - 유료 티어는 이 조항 없음.
GEMINI_API_KEY=

# Ollama 로컬 서버 주소 (기본값이면 비워둬도 됨)
OLLAMA_HOST=http://localhost:11434

# 텔레그램 알림 (선택, 나중에 사용)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
